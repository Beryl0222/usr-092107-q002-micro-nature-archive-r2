{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "微观自然影像档案领域事件",
  "type": "object",
  "required": [
    "event_id",
    "event_type",
    "aggregate_type",
    "aggregate_id",
    "occurred_at",
    "version",
    "summary"
  ],
  "properties": {
    "event_id": {
      "type": "string",
      "minLength": 1
    },
    "event_type": {
      "type": "string",
      "enum": [
        "OBSERVATION_REGISTERED",
        "IDENTIFICATION_REVIEWED",
        "ASSET_DERIVED",
        "USE_LICENSED",
        "PUBLICATION_FROZEN"
      ]
    },
    "aggregate_type": {
      "type": "string",
      "enum": [
        "field_observation",
        "media_asset",
        "taxon_review",
        "exhibition_use"
      ]
    },
    "aggregate_id": {
      "type": "string",
      "minLength": 1
    },
    "occurred_at": {
      "type": "string",
      "format": "date-time"
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "summary": {
      "type": "string",
      "minLength": 1
    }
  },
  "additionalProperties": true
}
