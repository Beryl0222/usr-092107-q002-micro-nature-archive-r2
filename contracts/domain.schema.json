{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "微观自然影像档案领域事件",
  "description": "所有记录一经接收，event_id、aggregate_id、occurred_at、version 不得原地改写；更正、撤回、改名一律以新的后继事件表达。payload 的具体形状按 event_type 在 $defs 中定义。",
  "type": "object",
  "required": [
    "event_id",
    "event_type",
    "aggregate_type",
    "aggregate_id",
    "occurred_at",
    "version",
    "summary",
    "payload"
  ],
  "properties": {
    "event_id": {
      "type": "string",
      "minLength": 1,
      "description": "事件全局唯一标识；重复提交同一 event_id 必须被幂等拒绝，不得形成第二次观察。"
    },
    "event_type": {
      "type": "string",
      "enum": [
        "OBSERVATION_REGISTERED",
        "IDENTIFICATION_REVIEWED",
        "ASSET_DERIVED",
        "USE_LICENSED",
        "USE_LICENSE_WITHDRAWN",
        "CREDIT_CORRECTED",
        "PUBLICATION_FROZEN",
        "USE_LOGGED"
      ]
    },
    "aggregate_type": {
      "type": "string",
      "enum": [
        "field_observation",
        "media_asset",
        "taxon_review",
        "exhibition_use"
      ]
    },
    "aggregate_id": {
      "type": "string",
      "minLength": 1
    },
    "occurred_at": {
      "type": "string",
      "format": "date-time"
    },
    "version": {
      "type": "integer",
      "minimum": 1,
      "description": "同一 aggregate_id 内从 1 起严格递增，不允许跳号或复用。"
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "payload": {
      "type": "object"
    }
  },
  "additionalProperties": true,
  "$defs": {
    "checksum": {
      "type": "object",
      "required": ["algorithm", "value"],
      "properties": {
        "algorithm": { "type": "string", "enum": ["sha256"] },
        "value": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "location": {
      "type": "object",
      "description": "精确坐标（exact）仅对具备资质的研究者开放；公众侧始终使用模糊位置（blurred）。",
      "required": ["precision", "label"],
      "properties": {
        "precision": { "type": "string", "enum": ["blurred", "exact"] },
        "label": { "type": "string", "minLength": 1 },
        "lat": { "type": "number", "minimum": -90, "maximum": 90 },
        "lon": { "type": "number", "minimum": -180, "maximum": 180 },
        "radius_m": { "type": "number", "minimum": 0 }
      },
      "allOf": [
        {
          "if": { "properties": { "precision": { "const": "exact" } } },
          "then": { "required": ["lat", "lon"] }
        }
      ]
    },
    "OBSERVATION_REGISTERED": {
      "required": [
        "observed_at",
        "photographer_id",
        "location",
        "conditions",
        "original_file"
      ],
      "properties": {
        "observed_at": { "type": "string", "format": "date-time" },
        "photographer_id": { "type": "string", "minLength": 1 },
        "photographer_display_name": { "type": "string" },
        "location": { "$ref": "#/$defs/location" },
        "sensitive_taxon": { "type": "boolean", "default": false },
        "conditions": {
          "type": "object",
          "required": ["habitat"],
          "properties": {
            "habitat": { "type": "string", "minLength": 1 },
            "weather": { "type": "string" },
            "temperature_c": { "type": "number" },
            "notes": { "type": "string" }
          }
        },
        "original_file": {
          "type": "object",
          "required": ["filename", "checksum"],
          "properties": {
            "filename": { "type": "string", "minLength": 1 },
            "checksum": { "$ref": "#/$defs/checksum" },
            "byte_size": { "type": "integer", "minimum": 0 }
          }
        },
        "initial_identification": {
          "type": "object",
          "required": ["scientific_name", "common_name", "basis"],
          "properties": {
            "scientific_name": { "type": "string", "minLength": 1 },
            "common_name": { "type": "string" },
            "taxonomy_source": { "type": "string" },
            "basis": {
              "type": "string",
              "enum": ["photographer", "curator", "expert"]
            },
            "confidence": {
              "type": "string",
              "enum": ["low", "medium", "high"]
            }
          }
        },
        "submission_id": {
          "type": "string",
          "description": "投稿批次去重键；同一 (submission_id) 重复登记不会产生第二条观察。"
        },
        "capture": {
          "type": "object",
          "description": "母版拍摄参数（区别于后期裁切、调色等派生变换）。",
          "properties": {
            "camera": { "type": "string" },
            "lens": { "type": "string" },
            "focal_length_mm": { "type": "number", "exclusiveMinimum": 0 },
            "aperture": { "type": "string" },
            "shutter_speed": { "type": "string" },
            "iso": { "type": "integer", "minimum": 1 },
            "magnification": { "type": "string" }
          }
        }
      }
    },
    "ASSET_DERIVED": {
      "required": ["derivative_asset_id", "parent_asset_id", "kind", "transform", "producer", "checksum"],
      "properties": {
        "derivative_asset_id": { "type": "string", "minLength": 1 },
        "parent_asset_id": {
          "type": "string",
          "description": "直接上游资产；原始文件约定为 'master:<observation_id>'，形成可追溯的派生链。"
        },
        "kind": {
          "type": "string",
          "enum": ["crop", "color_grade", "enlarge", "retouch", "other"]
        },
        "transform": {
          "type": "object",
          "description": "可复现的变换参数，例如裁切框、调色预设、放大倍率。",
          "additionalProperties": true
        },
        "producer": { "type": "string", "minLength": 1 },
        "checksum": { "$ref": "#/$defs/checksum" },
        "filename": { "type": "string" }
      }
    },
    "IDENTIFICATION_REVIEWED": {
      "required": ["review_seq", "scientific_name", "common_name", "basis", "decided_by", "decided_at"],
      "properties": {
        "review_seq": { "type": "integer", "minimum": 1 },
        "scientific_name": { "type": "string", "minLength": 1 },
        "common_name": { "type": "string" },
        "taxonomy_source": { "type": "string" },
        "basis": { "type": "string", "enum": ["photographer", "curator", "expert"] },
        "confidence": { "type": "string", "enum": ["low", "medium", "high"] },
        "decided_by": { "type": "string", "minLength": 1 },
        "decided_at": { "type": "string", "format": "date-time" },
        "supersedes_review_seq": {
          "type": "integer",
          "description": "被本次评审取代的上一评审序号。"
        },
        "note": { "type": "string" }
      }
    },
    "USE_LICENSED": {
      "required": ["license_id", "asset_id", "granted_by", "scopes", "granted_at"],
      "properties": {
        "license_id": { "type": "string", "minLength": 1 },
        "asset_id": { "type": "string", "minLength": 1 },
        "granted_by": { "type": "string", "minLength": 1 },
        "scopes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "enum": ["public_exhibition", "catalog_print", "research_citation", "commercial", "educational", "web_promotion"]
          },
          "uniqueItems": true
        },
        "granted_at": { "type": "string", "format": "date-time" },
        "expires_at": { "type": "string", "format": "date-time" },
        "terms": { "type": "string" }
      }
    },
    "USE_LICENSE_WITHDRAWN": {
      "required": ["license_id", "withdrawn_at", "reason"],
      "properties": {
        "license_id": { "type": "string", "minLength": 1 },
        "withdrawn_at": { "type": "string", "format": "date-time" },
        "reason": { "type": "string", "minLength": 1 },
        "retained_scopes": {
          "type": "array",
          "description": "撤回后依法保留的用途（默认 research_citation：撤权不影响已保存的科研引用）。",
          "items": { "type": "string", "enum": ["research_citation"] },
          "uniqueItems": true
        }
      }
    },
    "CREDIT_CORRECTED": {
      "required": ["asset_id", "correct_photographer_id", "corrected_at", "reason"],
      "properties": {
        "asset_id": { "type": "string", "minLength": 1 },
        "correct_photographer_id": { "type": "string", "minLength": 1 },
        "correct_display_name": { "type": "string" },
        "corrected_at": { "type": "string", "format": "date-time" },
        "reason": { "type": "string", "minLength": 1 }
      }
    },
    "PUBLICATION_FROZEN": {
      "required": ["publication_id", "asset_id", "frozen_at", "snapshot"],
      "properties": {
        "publication_id": { "type": "string", "minLength": 1 },
        "asset_id": { "type": "string", "minLength": 1 },
        "title": { "type": "string" },
        "frozen_at": { "type": "string", "format": "date-time" },
        "snapshot": {
          "type": "object",
          "description": "出版时点冻结的依据：鉴定名称、署名、所用资产校验值与许可状态。日后公众名称更新时，已出版图录仍显示此快照。",
          "required": ["scientific_name", "common_name", "credit", "asset_checksum"],
          "properties": {
            "scientific_name": { "type": "string" },
            "common_name": { "type": "string" },
            "credit": { "type": "string" },
            "asset_checksum": { "type": "string" },
            "license_scopes": { "type": "array", "items": { "type": "string" } }
          }
        }
      }
    },
    "USE_LOGGED": {
      "required": ["use_id", "asset_id", "purpose", "used_at", "used_by"],
      "properties": {
        "use_id": { "type": "string", "minLength": 1 },
        "asset_id": { "type": "string", "minLength": 1 },
        "publication_id": { "type": "string" },
        "exhibit_id": { "type": "string" },
        "purpose": {
          "type": "string",
          "enum": ["public_exhibition", "catalog_print", "research_citation", "commercial", "educational", "web_promotion", "research_export"]
        },
        "used_at": { "type": "string", "format": "date-time" },
        "used_by": { "type": "string", "minLength": 1 },
        "detail": { "type": "string" }
      }
    }
  }
}
